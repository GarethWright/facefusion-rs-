@inherits UiComponentBase
@*
    Gradio: facefusion/uis/components/background_remover_options.py. Python shows this block only
    while 'background_remover' is in the processors checkbox group (its listen() toggles visibility
    on that group's change event); the same condition is expressed directly here.
*@

@if (State.GetList("processors").Contains("background_remover"))
{
    <section class="ff-panel">
        <h2>BACKGROUND REMOVER</h2>
        <OptionDropdown StateKey="background_remover_model" />
        <OptionText StateKey="background_remover_fill_color" />
        <OptionText StateKey="background_remover_despill_color" />
    </section>
}
