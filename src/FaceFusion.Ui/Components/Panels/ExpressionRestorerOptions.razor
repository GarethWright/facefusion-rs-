@inherits UiComponentBase
@*
    Gradio: facefusion/uis/components/expression_restorer_options.py. Python shows this block only
    while 'expression_restorer' is in the processors checkbox group (its listen() toggles visibility
    on that group's change event); the same condition is expressed directly here.
*@

@if (State.GetList("processors").Contains("expression_restorer"))
{
    <section class="ff-panel">
        <h2>EXPRESSION RESTORER</h2>
        <OptionDropdown StateKey="expression_restorer_model" />
        <OptionSlider StateKey="expression_restorer_factor" />
        <OptionCheckboxGroup StateKey="expression_restorer_areas" />
    </section>
}
