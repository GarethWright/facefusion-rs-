@inherits UiComponentBase
@*
    Gradio: facefusion/uis/components/face_enhancer_options.py. Python shows this block only
    while 'face_enhancer' is in the processors checkbox group (its listen() toggles visibility
    on that group's change event); the same condition is expressed directly here.
*@

@if (State.GetList("processors").Contains("face_enhancer"))
{
    <section class="ff-panel">
        <h2>FACE ENHANCER</h2>
        <OptionDropdown StateKey="face_enhancer_model" />
        <OptionSlider StateKey="face_enhancer_blend" />
        <OptionSlider StateKey="face_enhancer_weight" />
    </section>
}
