@inherits UiComponentBase
@*
    Gradio: facefusion/uis/components/frame_enhancer_options.py. Python shows this block only
    while 'frame_enhancer' is in the processors checkbox group (its listen() toggles visibility
    on that group's change event); the same condition is expressed directly here.
*@

@if (State.GetList("processors").Contains("frame_enhancer"))
{
    <section class="ff-panel">
        <h2>FRAME ENHANCER</h2>
        <OptionDropdown StateKey="frame_enhancer_model" />
        <OptionSlider StateKey="frame_enhancer_blend" />
    </section>
}
