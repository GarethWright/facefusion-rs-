<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FaceFusion.Ui</RootNamespace>
  </PropertyGroup>

  <!--
    ContentRootPath is set to AppContext.BaseDirectory in Program.cs so the app can be started
    from any working directory; that means wwwroot has to be next to the binary rather than in
    the project directory, which the Web SDK does not do for a plain `dotnet build`.
  -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FaceFusion.Cli\FaceFusion.Cli.csproj" />
  </ItemGroup>

</Project>
